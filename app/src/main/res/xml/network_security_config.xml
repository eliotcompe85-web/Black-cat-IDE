<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, all internet traffic MUST use HTTPS / TLS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext HTTP is explicitly whitelisted ONLY for local inference endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- User's local on-device Mobile LM Server subnet -->
        <domain includeSubdomains="true">192.168.1.4</domain>
    </domain-config>
</network-security-config>
